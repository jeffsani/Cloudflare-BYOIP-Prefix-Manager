{
  "name": "prefix-mgr",
  "version": "1.0.0",
  "private": true,
  "description": "Prefix Manager — BYOIP Prefix Manager for Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create prefix-mgr-db",
    "db:init": "wrangler d1 execute prefix-mgr-db --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute prefix-mgr-db --remote --file=schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chanfana": "^3.4.0",
    "hono": "^4.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260706.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.93.1"
  }
}
