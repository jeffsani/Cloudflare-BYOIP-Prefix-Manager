{
  "name": "network-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Network Tools — BYOIP Prefix Manager for Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create network-tools-db",
    "db:init": "wrangler d1 execute network-tools-db --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute network-tools-db --remote --file=schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260706.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.93.1"
  }
}
